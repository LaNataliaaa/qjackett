def handle_toggle_sort(cache_file, state_file):
    """Cycle sort order (seeds -> size -> date -> peers -> seeds) and output rows for fzf reload."""
    try:
        with open(cache_file, "r", encoding="utf-8") as f:
            data = json.load(f)

        curr_mode = "seeds"
        if os.path.exists(state_file):
            try:
                with open(state_file, "r", encoding="utf-8") as sf:
                    state = json.load(sf)
                    curr_mode = state.get("sort", "seeds")
            except Exception:
                pass

        order_cycle = ["seeds", "size", "date", "peers"]
        next_mode = order_cycle[(order_cycle.index(curr_mode) + 1) % len(order_cycle)] if curr_mode in order_cycle else "seeds"

        indexed = list(enumerate(data))
        if next_mode == "seeds":
            indexed.sort(key=lambda x: int(x[1].get("Seeders") or 0), reverse=True)
        elif next_mode == "size":
            indexed.sort(key=lambda x: int(x[1].get("Size") or 0), reverse=True)
        elif next_mode == "date":
            indexed.sort(key=lambda x: str(x[1].get("PublishDate") or ""), reverse=True)
        elif next_mode == "peers":
            indexed.sort(key=lambda x: int(x[1].get("Peers") or 0), reverse=True)

        for idx, r in indexed:
            print(format_list_line(idx, r))

        try:
            with open(state_file, "w", encoding="utf-8") as sf:
                json.dump({"sort": next_mode}, sf)
        except Exception:
            pass
    except Exception:
        pass


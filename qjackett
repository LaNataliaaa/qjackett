def boost_magnet_link(link, enabled=True):
    """Append high-speed healthy public trackers to magnet link to accelerate discovery."""
    if not enabled or not link or not link.startswith("magnet:?"):
        return link
    existing = set(re.findall(r'tr=([^&]+)', link))
    new_tr = []
    for t in DEFAULT_BOOSTER_TRACKERS:
        encoded = urllib.parse.quote(t)
        if encoded not in existing and t not in existing:
            new_tr.append(f"tr={encoded}")
    if new_tr:
        sep = "&" if "?" in link else "?"
        return link + sep + "&".join(new_tr)
    return link



def get_arr_config(service):
    """Auto-detect API key and port for Radarr, Sonarr, Lidarr, Bazarr from local config."""
    service_lower = service.lower()
    default_ports = {"radarr": 7878, "sonarr": 8989, "lidarr": 8686, "readarr": 8787, "bazarr": 6767}
    port = default_ports.get(service_lower, 7878)
    api_key = ""

    if service_lower == "bazarr":
        b_cfg = os.path.expanduser("~/.config/Bazarr/config/config.yaml")
        if os.path.exists(b_cfg):
            try:
                with open(b_cfg, "r", encoding="utf-8") as f:
                    content = f.read()
                    m_key = re.search(r'apikey:\s*([a-zA-Z0-9]+)', content)
                    if m_key:
                        api_key = m_key.group(1).strip()
            except Exception:
                pass
        return f"http://127.0.0.1:{port}", api_key

    # Radarr / Sonarr / Lidarr XML config
    xml_path = os.path.expanduser(f"~/.config/{service.capitalize()}/config.xml")
    if os.path.exists(xml_path):
        try:
            with open(xml_path, "r", encoding="utf-8") as f:
                content = f.read()
                m_key = re.search(r'<ApiKey>([^<]+)</ApiKey>', content)
                if m_key:
                    api_key = m_key.group(1).strip()
                m_port = re.search(r'<Port>(\d+)</Port>', content)
                if m_port:
                    port = int(m_port.group(1).strip())
        except Exception:
            pass

    return f"http://127.0.0.1:{port}", api_key

def push_to_arr(item, config):
    """Push release directly to Radarr, Sonarr or Lidarr API."""
    cat_key = item.get("_cat_key", "other")
    if cat_key in ("tv", "anime"):
        service = "sonarr"
    elif cat_key == "music":
        service = "lidarr"
    else:
        service = "radarr"

    base_url, api_key = get_arr_config(service)
    cfg_key = config.get(f"{service}_api_key")
    if cfg_key:
        api_key = cfg_key

    if not api_key:
        return False, f"No se encontró la API Key de {service.capitalize()}"

    url = f"{base_url}/api/v3/release/push"
    payload = json.dumps({
        "title": item.get("Title", "Release"),
        "downloadUrl": item.get("MagnetUri") or item.get("Link", ""),
        "size": item.get("Size", 0),
        "infoHash": item.get("InfoHash", ""),
        "indexer": item.get("Tracker", "qJackett")
    }).encode("utf-8")

    req = urllib.request.Request(
        url,
        data=payload,
        headers={"Content-Type": "application/json", "X-Api-Key": api_key, "User-Agent": "qjackett/1.5"}
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            return resp.status in (200, 201), f"Enviado con éxito a {service.capitalize()}"
    except urllib.error.HTTPError as e:
        return False, f"HTTP {e.code} desde {service.capitalize()}"
    except Exception as e:
        return False, str(e)



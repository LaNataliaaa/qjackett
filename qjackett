def handle_select_files(idx_str, cache_file, config):
    """Interactive selective files downloader for a torrent."""
    try:
        idx = int(idx_str)
        with open(cache_file, "r", encoding="utf-8") as f:
            data = json.load(f)
        if idx < 0 or idx >= len(data):
            return
        r = data[idx]
        title = r.get("Title", "Torrent")
        link = boost_magnet_link(r.get("MagnetUri") or r.get("Link"), enabled=config.get("tracker_booster", True))
        info_hash = (r.get("InfoHash") or "").lower()

        qb = QBittorrentClient(
            base_url=config.get("qbittorrent_url", "http://127.0.0.1:8080"),
            username=config.get("qbittorrent_username", ""),
            password=config.get("qbittorrent_password", "")
        )

        files = r.get("_files_list") or []

        if not files:
            qb.add_torrent(link, paused=True)
            for _ in range(5):
                time.sleep(0.8)
                q_files = qb.get_torrent_files(info_hash)
                if q_files:
                    files = [{"index": f["index"], "path": f["name"], "size": f["size"]} for f in q_files]
                    break

        if not files:
            print("\x1b[1;33mNo se pudo obtener la lista de archivos para selección.\x1b[0m")
            return

        fzf_lines = [f"{fl.get('index', i)}\t{format_size(fl.get('size', 0)):>9}  {fl.get('path', 'Archivo')}"
                     for i, fl in enumerate(files)]

        p = subprocess.Popen([
            "fzf", "--multi", "--ansi",
            f"--header=SELECCIONA ARCHIVOS CON [TAB] Y PULSA [ENTER] ({title[:50]}):",
            "--delimiter=\t", "--with-nth=2.."
        ], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        out, _ = p.communicate(input="\n".join(fzf_lines))

        if not out:
            return

        chosen_indices = set()
        for line in out.splitlines():
            if "\t" in line:
                try:
                    chosen_indices.add(int(line.split("\t")[0]))
                except ValueError:
                    pass

        if not chosen_indices:
            return

        qb.add_torrent(link, paused=True)
        all_indices = set(fl.get("index", i) for i, fl in enumerate(files))
        ignored = list(all_indices - chosen_indices)

        if ignored and info_hash:
            qb.set_file_priorities(info_hash, ignored, priority=0)
            qb.set_file_priorities(info_hash, list(chosen_indices), priority=1)
            qb.resume_torrent(info_hash)
            send_notification("qJackett - Descarga Selectiva", f"✔ Descargando {len(chosen_indices)}/{len(files)} archivos de:\n{title[:50]}")
    except Exception as e:
        print(f"Error en descarga selectiva: {e}")


def format_size(bytes_val):
    """Format bytes into human readable string (e.g. 1.5 GB)."""
    try:
        val = float(bytes_val)
        for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
            if val < 1024.0:
                return f"{val:.1f} {unit}"
            val /= 1024.0
        return f"{val:.1f} PB"
    except Exception:
        return "N/A"

def parse_size(size_str):
    """Parse human readable size string (e.g. 500M, 1.5GB) to integer bytes."""
    if not size_str:
        return None
    s = str(size_str).strip().upper()
    m = re.match(r'^([\d.]+)\s*([KMGTPE]?I?B?)$', s)
    if not m:
        return None
    try:
        val = float(m.group(1))
        unit = m.group(2)
        multipliers = {
            '': 1, 'B': 1,
            'K': 1024, 'KB': 1024, 'KIB': 1024,
            'M': 1024**2, 'MB': 1024**2, 'MIB': 1024**2,
            'G': 1024**3, 'GB': 1024**3, 'GIB': 1024**3,
            'T': 1024**4, 'TB': 1024**4, 'TIB': 1024**4,
            'P': 1024**5, 'PB': 1024**5, 'PIB': 1024**5,
        }
        mult = multipliers.get(unit, 1)
        return int(val * mult)
    except Exception:
        return None

def format_speed(bytes_per_sec):
    """Format bytes/sec to human speed string (e.g. 12.5 MB/s)."""
    try:
        val = float(bytes_per_sec)
        if val <= 0:
            return "0.0 B/s"
        return f"{format_size(val)}/s"
    except Exception:
        return "0.0 B/s"

def format_eta(seconds):
    """Format ETA in seconds into human readable time (e.g. 45m 12s, 2h 10m)."""
    try:
        sec = int(seconds)
        if sec < 0 or sec >= 8640000: # Over 100 days
            return "∞"
        if sec < 60:
            return f"{sec}s"
        m, s = divmod(sec, 60)
        h, m = divmod(m, 60)
        if h > 0:
            return f"{h}h {m:02d}m"
        return f"{m}m {s:02d}s"
    except Exception:
        return "N/A"

def parse_time_seconds(time_str):
    """Parse time string like '30s', '15m', '2h', '1d' into integer seconds."""
    if not time_str:
        return 1800
    m = re.match(r'^(\d+)\s*([smhd]?)$', str(time_str).strip().lower())
    if not m:
        return 1800
    val = int(m.group(1))
    unit = m.group(2)
    mults = {'': 1, 's': 1, 'm': 60, 'h': 3600, 'd': 86400}
    return val * mults.get(unit, 1)

def copy_to_clipboard(text):
    """Copy text to system clipboard with transparent Wayland and X11 fallbacks."""
    if not text:
        return False
    payload = text.encode("utf-8")

    # 1. Wayland wl-copy
    try:
        p = subprocess.run(["wl-copy"], input=payload, check=False,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if p.returncode == 0:
            return True
    except FileNotFoundError:
        pass

    # 2. X11 xclip
    try:
        p = subprocess.run(["xclip", "-selection", "clipboard"], input=payload, check=False,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if p.returncode == 0:
            return True
    except FileNotFoundError:
        pass

    # 3. X11 xsel
    try:
        p = subprocess.run(["xsel", "--clipboard", "--input"], input=payload, check=False,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if p.returncode == 0:
            return True
    except FileNotFoundError:
        pass

    return False


def get_jackett_api_key(config):
    """Retrieve Jackett API key from config or ServerConfig.json."""
    if config.get("jackett_api_key"):
        return config["jackett_api_key"]

    if os.path.exists(DEFAULT_JACKETT_CONFIG):
        try:
            with open(DEFAULT_JACKETT_CONFIG, "r", encoding="utf-8") as f:
                data = json.load(f)
                return data.get("APIKey", "")
        except Exception:
            pass

    return ""

def get_configured_indexers(filter_indexers=None):
    """Find all configured indexers in Jackett directory."""
    indexers_dir = os.path.expanduser("~/.config/Jackett/Indexers")
    if not os.path.isdir(indexers_dir):
        return []
    files = glob.glob(os.path.join(indexers_dir, "*.json"))
    all_indexers = [os.path.splitext(os.path.basename(f))[0] for f in files if not f.endswith(".bak")]

    if filter_indexers:
        patterns = [p.strip().lower() for p in filter_indexers if p.strip()]
        matched = []
        for idx in all_indexers:
            idx_lower = idx.lower()
            if any(p == idx_lower or p in idx_lower for p in patterns):
                matched.append(idx)
        return matched

    return all_indexers

def search_indexer(indexer, query, api_key, jackett_url, timeout=5.0):
    """Query a single Jackett indexer concurrently."""
    encoded_query = urllib.parse.quote(query)
    base_url = jackett_url.rstrip("/")
    url = f"{base_url}/api/v2.0/indexers/{indexer}/results?apikey={api_key}&Query={encoded_query}"
    req = urllib.request.Request(url, headers={"User-Agent": "qjackett/1.5 (TUI; Linux)"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8", errors="ignore"))
            res = data.get("Results", [])
            for r in res:
                r["_source"] = "jackett"
            return res
    except Exception:
        return []

def search_bitmagnet(query, base_url="http://127.0.0.1:3333", limit=80, timeout=3.5):
    """Query BitMagnet GraphQL endpoint for rapid local DHT torrent results."""
    graphql_url = f"{base_url.rstrip('/')}/graphql"
    escaped_query = json.dumps(query)
    gql_query = f"""{{
      torrentContent {{
        search(input: {{
          queryString: {escaped_query},
          limit: {limit}
        }}) {{
          items {{
            infoHash
            contentType
            title
            torrent {{
              name
              size
              filesCount
              fileType
              seeders
              leechers
              magnetUri
              files {{
                index
                path
                size
              }}
            }}
          }}
        }}
      }}
    }}"""
    req_body = json.dumps({"query": gql_query}).encode("utf-8")
    req = urllib.request.Request(
        graphql_url,
        data=req_body,
        headers={"Content-Type": "application/json", "User-Agent": "qjackett/1.5"}
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = json.loads(resp.read().decode("utf-8", errors="ignore"))
            items = (raw.get("data") or {}).get("torrentContent", {}).get("search", {}).get("items") or []
            results = []
            for it in items:
                t = it.get("torrent") or {}
                title = it.get("title") or t.get("name") or "Sin título"
                info_hash = (it.get("infoHash") or "").lower()
                magnet = t.get("magnetUri") or ""
                if not magnet and info_hash:
                    magnet = f"magnet:?xt=urn:btih:{info_hash}&dn={urllib.parse.quote(title)}"
                files = t.get("files") or []
                files_cnt = t.get("filesCount") or len(files)
                results.append({
                    "Title": title,
                    "Tracker": "BitMagnet (DHT)",
                    "Size": t.get("size") or 0,
                    "Seeders": t.get("seeders") or 0,
                    "Peers": t.get("leechers") or 0,
                    "MagnetUri": magnet,
                    "InfoHash": info_hash,
                    "Files": files_cnt,
                    "_files_list": files,
                    "CategoryDesc": it.get("contentType") or "other",
                    "_source": "bitmagnet",
                    "DownloadVolumeFactor": 0
                })
            return results
    except Exception:
        return []



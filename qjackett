def main():
    # Handle subcommands called by fzf directly
    if len(sys.argv) >= 4:
        subcmd = sys.argv[1]
        idx_arg = sys.argv[2]
        cache_arg = sys.argv[3]
        if subcmd == "__preview__":
            handle_preview(idx_arg, cache_arg)
            sys.exit(0)
        elif subcmd == "__copy_magnet__":
            handle_copy_magnet(idx_arg, cache_arg)
            sys.exit(0)
        elif subcmd == "__copy_title__":
            handle_copy_title(idx_arg, cache_arg)
            sys.exit(0)
        elif subcmd == "__open_link__":
            handle_open_link(idx_arg, cache_arg)
            sys.exit(0)

    parser = argparse.ArgumentParser(
        prog="qjackett",
        description="qJackett: Buscador interactivo TUI de torrents supercargado (Jackett + fzf + qBittorrent)",
        usage="%(prog)s [opciones] [termino_de_busqueda]"
    )
    parser.add_argument("query", nargs="*", help="Término o título a buscar")
    parser.add_argument("-c", "--category",
                        choices=["movies", "tv", "anime", "games", "music", "books", "apps", "xxx"],
                        help="Filtrar por categoría")
    parser.add_argument("-s", "--min-seeds", type=int, default=None, help="Mínimo de semillas (seeders)")
    parser.add_argument("-x", "--exclude", help="Palabras a excluir separadas por comas (ej. cam,ts,latino)")
    parser.add_argument("--min-size", help="Tamaño mínimo (ej. 500M, 1.5G, 10GB)")
    parser.add_argument("--max-size", help="Tamaño máximo (ej. 4GB, 25GB)")
    parser.add_argument("-i", "--indexer", help="Filtrar indexers específicos por nombre (ej. therarbg,yts)")
    parser.add_argument("--sort", choices=["seeds", "peers", "size", "date"], default=None,
                        help="Criterio de ordenación (default: seeds)")
    parser.add_argument("-r", "--reverse", action="store_true", help="Invertir el orden de clasificación")
    parser.add_argument("-p", "--paused", action="store_true", help="Inyectar torrents en estado pausado")
    parser.add_argument("-l", "--loop", action="store_true", help="Modo interactivo continuo (bucle de búsqueda)")
    parser.add_argument("--config", help="Ruta personalizada a archivo de configuración JSON")
    parser.add_argument("--init-config", action="store_true", help="Crear archivo de configuración inicial")
    parser.add_argument("-v", "--version", action="version", version=f"%(prog)s v{VERSION}")

    args = parser.parse_args()

    # Handle --init-config
    if args.init_config:
        target = args.config or DEFAULT_CONFIG_PATH
        if init_config_file(target):
            print(f"\x1b[1;32m✔ Archivo de configuración creado con éxito en:\x1b[0m\n  {target}")
        else:
            print(f"\x1b[1;33mEl archivo de configuración ya existe en:\x1b[0m\n  {target}")
        sys.exit(0)

    # Load configuration
    config = load_config(args.config)

    # Check Jackett API key
    api_key = get_jackett_api_key(config)
    if not api_key:
        print(f"\x1b[1;31mError: No se encontró la API Key de Jackett.\x1b[0m")
        print("Configúrala en ~/.config/qjackett/config.json o inicia Jackett una vez.")
        sys.exit(1)

    # Check configured indexers
    filter_list = args.indexer.split(",") if args.indexer else None
    indexers = get_configured_indexers(filter_list)
    if not indexers:
        print("\x1b[1;31mError: No se encontraron indexers configurados en Jackett.\x1b[0m")
        if filter_list:
            print(f"Comprueba los filtros de indexer especificados: {args.indexer}")
        sys.exit(1)

    # Initialize qBittorrent client
    qb_client = QBittorrentClient(
        base_url=config.get("qbittorrent_url", "http://127.0.0.1:8080"),
        username=config.get("qbittorrent_username", ""),
        password=config.get("qbittorrent_password", "")
    )

    query_str = " ".join(args.query).strip() if args.query else ""
    interactive_mode = not bool(query_str)

    while True:
        if not query_str:
            print("\x1b[1;36m┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\x1b[0m")
            print(f"\x1b[1;36m┃\x1b[0m \x1b[1;32m      ⚡ QJACKETT v{VERSION} — BUSCADOR TURBO DE TORRENTS     \x1b[0m \x1b[1;36m┃\x1b[0m")
            print("\x1b[1;36m┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\x1b[0m")
            try:
                query_str = input("\x1b[1m🔍 Introduce qué quieres buscar (Enter vacío para salir):\x1b[0m ").strip()
            except (KeyboardInterrupt, EOFError):
                print("\nOperación cancelada.")
                break

        if not query_str:
            print("Saliendo de qJackett.")
            break

        results = run_query(query_str, config, args, api_key, indexers)
        if results:
            run_fzf_tui(results, config, args, qb_client)

        # Loop control
        if not (args.loop or interactive_mode):
            break

        query_str = ""
        print()


if __name__ == "__main__":
    main()

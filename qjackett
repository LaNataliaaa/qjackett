class QBittorrentClient:
    """Manages connection and torrent injection into qBittorrent WebUI."""

    def __init__(self, base_url="http://127.0.0.1:8080", username="", password=""):
        self.base_url = base_url.rstrip("/")
        self.username = username or ""
        self.password = password or ""
        self.cookie_jar = http.cookiejar.CookieJar()
        self.opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(self.cookie_jar))

    def login(self):
        """Authenticate with qBittorrent WebUI."""
        if not self.username:
            return True
        login_url = f"{self.base_url}/api/v2/auth/login"
        post_data = urllib.parse.urlencode({
            "username": self.username,
            "password": self.password
        }).encode("utf-8")
        req = urllib.request.Request(
            login_url,
            data=post_data,
            headers={"User-Agent": "qjackett/1.2", "Referer": self.base_url}
        )
        try:
            with self.opener.open(req, timeout=5) as resp:
                text = resp.read().decode("utf-8", errors="ignore")
                return text.strip() == "Ok." or resp.status == 200
        except Exception:
            return False

    def add_torrent(self, urls, category=None, tags=None, paused=False, auto_tmm=True):
        """Inject torrent magnet link or URL into qBittorrent."""
        add_url = f"{self.base_url}/api/v2/torrents/add"
        if isinstance(urls, list):
            urls_str = "\n".join(urls)
        else:
            urls_str = str(urls)

        payload = {
            "urls": urls_str,
            "paused": "true" if paused else "false",
            "autoTMM": "true" if auto_tmm else "false"
        }
        if category:
            payload["category"] = category
        if tags:
            if isinstance(tags, (list, set, tuple)):
                payload["tags"] = ", ".join(tags)
            else:
                payload["tags"] = str(tags)

        post_data = urllib.parse.urlencode(payload).encode("utf-8")
        req = urllib.request.Request(
            add_url,
            data=post_data,
            headers={"User-Agent": "qjackett/1.2", "Referer": self.base_url}
        )

        try:
            with self.opener.open(req, timeout=6) as resp:
                return resp.status == 200
        except urllib.error.HTTPError as e:
            status_code = e.code
            try:
                e.close()
            except Exception:
                pass
            if status_code == 403 and self.username:
                if self.login():
                    try:
                        with self.opener.open(req, timeout=6) as resp2:
                            return resp2.status == 200
                    except Exception:
                        return False
            return False
        except Exception:
            return False



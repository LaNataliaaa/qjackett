def handle_copy_magnet(idx_str, cache_file):
    """Copy magnet link of selected item and show desktop notification."""
    try:
        idx = int(idx_str)
        with open(cache_file, "r", encoding="utf-8") as f:
            data = json.load(f)
        if 0 <= idx < len(data):
            r = data[idx]
            link = r.get("MagnetUri") or r.get("Link")
            if link:
                copy_to_clipboard(link)
                title = r.get("Title", "Torrent")
                send_notification("qJackett", f"🧲 Magnet copiado al portapapeles:\n{title[:60]}", icon="edit-copy")
    except Exception:
        pass


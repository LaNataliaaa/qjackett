def run_watcher(query_str, interval_sec, config, args, api_key, indexers, qb_client):
    """Run continuous watcher for new releases and auto-inject into qBittorrent."""
    os.makedirs(DEFAULT_CACHE_DIR, exist_ok=True)
    seen_hashes = set()

    if os.path.exists(DEFAULT_WATCHER_SEEN_PATH):
        try:
            with open(DEFAULT_WATCHER_SEEN_PATH, "r", encoding="utf-8") as f:
                seen_hashes = set(json.load(f))
        except Exception:
            pass

    print(f"\x1b[1;36m╭{'─' * 57}╮\x1b[0m")
    print(f"\x1b[1;36m│\x1b[0m \x1b[1;32m      🤖 QJACKETT WATCHER — MODO VIGILANCIA ACTIVA      \x1b[0m \x1b[1;36m│\x1b[0m")
    print(f"\x1b[1;36m╰{'─' * 57}╯\x1b[0m")
    print(f"Vigilando: \x1b[1m'{query_str}'\x1b[0m | Intervalo: \x1b[36m{interval_sec}s\x1b[0m | Seeds min: \x1b[32m{args.min_seeds or 1}\x1b[0m\n")

    try:
        while True:
            t_str = time.strftime("%H:%M:%S")
            print(f"\x1b[90m[{t_str}]\x1b[0m Comprobando nuevos releases...", end="\r", flush=True)

            results = run_query(query_str, config, args, api_key, indexers, quiet=True)
            new_torrents = []

            for r in results:
                h = (r.get("InfoHash") or "").lower()
                if h and h not in seen_hashes:
                    new_torrents.append(r)
                    seen_hashes.add(h)

            if new_torrents:
                print(f"\n\x1b[1;32m[{t_str}] ¡Se encontraron {len(new_torrents)} nuevo(s) release(s)!\x1b[0m")
                for r in new_torrents:
                    link = boost_magnet_link(r.get("MagnetUri") or r.get("Link"), enabled=config.get("tracker_booster", True))
                    title = r.get("Title", "Torrent")
                    cat_key = r.get("_cat_key")
                    category = cat_key if config.get("auto_category", True) and cat_key != "other" else None
                    tags = ["qjackett", "watcher"]
                    ok = qb_client.add_torrent(link, category=category, tags=tags, paused=args.paused)
                    if ok:
                        print(f"  \x1b[1;32m✔ Inyectado:\x1b[0m {title[:60]}")
                        send_notification("qJackett Watcher", f"Nuevo release inyectado:\n{title[:60]}", icon="software-update-available")

                try:
                    with open(DEFAULT_WATCHER_SEEN_PATH, "w", encoding="utf-8") as f:
                        json.dump(list(seen_hashes), f)
                except Exception:
                    pass

            time.sleep(interval_sec)
    except KeyboardInterrupt:
        print("\nWatcher detenido por el usuario.")



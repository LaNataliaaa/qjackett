def main():
    if len(sys.argv) >= 2 and sys.argv[1].startswith("__"):
        subcmd = sys.argv[1]
        cfg = load_config()
        if subcmd == "__preview__" and len(sys.argv) >= 4:
            handle_preview(sys.argv[2], sys.argv[3])
            sys.exit(0)
        elif subcmd == "__help__":
            handle_help()
            sys.exit(0)
        elif subcmd == "__files__" and len(sys.argv) >= 4:
            handle_files(sys.argv[2], sys.argv[3])
            sys.exit(0)
        elif subcmd == "__copy_magnet__" and len(sys.argv) >= 4:
            handle_copy_magnet(sys.argv[2], sys.argv[3])
            sys.exit(0)
        elif subcmd == "__copy_title__" and len(sys.argv) >= 4:
            handle_copy_title(sys.argv[2], sys.argv[3])
            sys.exit(0)
        elif subcmd == "__open_link__" and len(sys.argv) >= 4:
            handle_open_link(sys.argv[2], sys.argv[3])
            sys.exit(0)
        elif subcmd == "__bookmark__" and len(sys.argv) >= 4:
            handle_bookmark(sys.argv[2], sys.argv[3])
            sys.exit(0)
        elif subcmd == "__stream__" and len(sys.argv) >= 4:
            handle_stream(sys.argv[2], sys.argv[3], cfg)
            sys.exit(0)
        elif subcmd == "__push_arr__" and len(sys.argv) >= 4:
            handle_push_arr(sys.argv[2], sys.argv[3], cfg)
            sys.exit(0)
        elif subcmd == "__subtitles__" and len(sys.argv) >= 4:
            handle_subtitles(sys.argv[2], sys.argv[3])
            sys.exit(0)
        elif subcmd == "__filter__" and len(sys.argv) >= 4:
            st_file = sys.argv[4] if len(sys.argv) >= 5 else None
            handle_filter(sys.argv[2], sys.argv[3], st_file)
            sys.exit(0)
        elif subcmd == "__toggle_sort__" and len(sys.argv) >= 4:
            handle_toggle_sort(sys.argv[2], sys.argv[3])
            sys.exit(0)
        elif subcmd == "__downloads__":
            qb = QBittorrentClient(
                base_url=cfg.get("qbittorrent_url", "http://127.0.0.1:8080"),
                username=cfg.get("qbittorrent_username", ""),
                password=cfg.get("qbittorrent_password", "")
            )
            display_qbittorrent_downloads(qb)
            sys.exit(0)

    parser = argparse.ArgumentParser(
        prog="qjackett",
        description=f"qJackett v{VERSION}: Buscador interactivo TUI supercargado (Jackett + BitMagnet + fzf + qBittorrent + TMDB)",
        usage="%(prog)s [opciones] [termino_de_busqueda]"
    )
    parser.add_argument("query", nargs="*", help="Término o título a buscar")
    parser.add_argument("-c", "--category",
                        choices=["movies", "tv", "anime", "games", "music", "books", "apps", "xxx"],
                        help="Filtrar por categoría")
    parser.add_argument("-s", "--min-seeds", type=int, default=None, help="Mínimo de semillas (seeders)")
    parser.add_argument("-x", "--exclude", help="Palabras a excluir separadas por comas (ej. cam,ts,latino)")
    parser.add_argument("--min-size", help="Tamaño mínimo (ej. 500M, 1.5G, 10GB)")
    parser.add_argument("--max-size", help="Tamaño máximo (ej. 4GB, 25GB)")
    parser.add_argument("-i", "--indexer", help="Filtrar indexers específicos por nombre (ej. therarbg,yts)")
    parser.add_argument("--source", choices=["all", "jackett", "bitmagnet"], default="all",
                        help="Fuente de búsqueda: 'all' (híbrido Jackett+BitMagnet), 'jackett' o 'bitmagnet'")
    parser.add_argument("--sort", choices=["seeds", "peers", "size", "date"], default=None,
                        help="Criterio de ordenación (default: seeds)")
    parser.add_argument("--theme", choices=["default", "catppuccin", "tokyonight", "nord"], default=None,
                        help="Perfil de color para el TUI (default: default)")
    parser.add_argument("-r", "--reverse", action="store_true", help="Invertir el orden de clasificación")
    parser.add_argument("-p", "--paused", action="store_true", help="Inyectar torrents en estado pausado")
    parser.add_argument("--stream", action="store_true", help="Inyectar con descarga secuencial para streaming inmediato (mpv)")
    parser.add_argument("-d", "--downloads", action="store_true", help="Ver monitor de descargas activas en qBittorrent")
    parser.add_argument("-b", "--bookmarks", action="store_true", help="Explorar y gestionar torrents guardados en Marcadores")
    parser.add_argument("--json", action="store_true", help="Emitir resultados formateados en JSON directamente para scripting/jq")
    parser.add_argument("-q", "--quiet", action="store_true", help="Suprimir mensajes informativos en terminal")
    parser.add_argument("--watch", action="store_true", help="Modo vigilancia en segundo plano para nuevos releases")
    parser.add_argument("--interval", default="30m", help="Intervalo entre comprobaciones del modo vigilancia (ej. 15m, 1h, 30s)")
    parser.add_argument("--completions", choices=["bash", "zsh", "fish"], help="Generar script de autocompletado para el shell")
    parser.add_argument("-l", "--loop", action="store_true", help="Modo interactivo continuo (bucle de búsqueda)")
    parser.add_argument("--config", help="Ruta personalizada a archivo de configuración JSON")
    parser.add_argument("--init-config", action="store_true", help="Crear archivo de configuración inicial")
    parser.add_argument("-v", "--version", action="version", version=f"%(prog)s v{VERSION}")

    args = parser.parse_args()

    if args.completions:
        print(generate_completions(args.completions))
        sys.exit(0)

    config = load_config(args.config)
    if args.theme:
        config["theme"] = args.theme

    qb_client = QBittorrentClient(
        base_url=config.get("qbittorrent_url", "http://127.0.0.1:8080"),
        username=config.get("qbittorrent_username", ""),
        password=config.get("qbittorrent_password", "")
    )

    if args.downloads:
        display_qbittorrent_downloads(qb_client)
        sys.exit(0)

    if args.bookmarks:
        bookmarks = load_bookmarks()
        if not bookmarks:
            print("\x1b[1;33mNo tienes torrents guardados en Marcadores (~/.config/qjackett/bookmarks.json).\x1b[0m")
            print("Guarda cualquiera pulsando [CTRL + B] en el TUI.")
            sys.exit(0)
        for b in bookmarks:
            b["_source"] = b.get("_source", "bookmark")
            b["_badge"], b["_cat_key"] = get_category_badge(b.get("CategoryDesc"), b.get("Category"), b.get("Title", ""))
            b["_tags"] = extract_tags(b.get("Title", ""))
        run_fzf_tui(bookmarks, config, args, qb_client)
        sys.exit(0)

    if args.init_config:
        target = args.config or DEFAULT_CONFIG_PATH
        if init_config_file(target):
            print(f"\x1b[1;32m✔ Archivo de configuración creado con éxito en:\x1b[0m\n  {target}")
        else:
            print(f"\x1b[1;33mEl archivo de configuración ya existe en:\x1b[0m\n  {target}")
        sys.exit(0)

    api_key = get_jackett_api_key(config)
    indexers = []
    if args.source in ("all", "jackett"):
        if not api_key:
            if args.source == "jackett":
                print(f"\x1b[1;31mError: No se encontró la API Key de Jackett.\x1b[0m")
                sys.exit(1)
        else:
            filter_list = args.indexer.split(",") if args.indexer else None
            indexers = get_configured_indexers(filter_list)

    query_str = " ".join(args.query).strip() if args.query else ""

    if args.watch:
        if not query_str:
            print("\x1b[1;31mError: El modo vigilancia (--watch) requiere especificar un término de búsqueda.\x1b[0m")
            sys.exit(1)
        interval_sec = parse_time_seconds(args.interval)
        run_watcher(query_str, interval_sec, config, args, api_key, indexers, qb_client)
        sys.exit(0)

    if args.json:
        if not query_str:
            print("[]")
            sys.exit(0)
        results = run_query(query_str, config, args, api_key, indexers, quiet=True)
        clean_results = []
        for r in results:
            item_c = dict(r)
            clean_results.append(item_c)
        json.dump(clean_results, sys.stdout, indent=2, ensure_ascii=False)
        sys.exit(0)

    setup_readline_history()
    interactive_mode = not bool(query_str)

    while True:
        if not query_str:
            border = "─" * 57
            print(f"\x1b[1;36m╭{border}╮\x1b[0m")
            print(f"\x1b[1;36m│\x1b[0m \x1b[1;32m      ⚡ QJACKETT v{VERSION} — BUSCADOR TURBO DE TORRENTS     \x1b[0m \x1b[1;36m│\x1b[0m")
            print(f"\x1b[1;36m╰{border}╯\x1b[0m")
            try:
                query_str = input("\x1b[1m🔍 Introduce qué quieres buscar (Enter vacío para salir):\x1b[0m ").strip()
            except (KeyboardInterrupt, EOFError):
                print("\nOperación cancelada.")
                break

        if not query_str:
            print("Saliendo de qJackett.")
            break

        save_readline_history()
        results = run_query(query_str, config, args, api_key, indexers, quiet=args.quiet)
        if results:
            run_fzf_tui(results, config, args, qb_client)

        if not (args.loop or interactive_mode):
            break

        query_str = ""
        print()


if __name__ == "__main__":
    main()

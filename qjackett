def format_list_line(idx, r):
    """Format single result row for fzf display with fixed tabular column alignment."""
    seeds = int(r.get("Seeders") or 0)
    peers = int(r.get("Peers") or 0)
    size_str = format_size(r.get("Size", 0))
    tracker = (r.get("Tracker") or "Unknown")[:12]
    title = (r.get("Title") or "Sin título").replace("\t", " ")
    badge = r.get("_badge", "📦 General")
    fl = r.get("DownloadVolumeFactor", 1) == 0
    source = r.get("_source", "jackett")

    # Security check badge
    sec_code, _, _ = check_security_status(
        title, int(r.get("Size") or 0), r.get("_cat_key", "other"),
        files_list=r.get("_files_list", []), seeders=seeds, leechers=peers, tracker=tracker
    )
    if sec_code == "danger":
        sec_fmt = "\x1b[1;41;37m☣️\x1b[0m "
    elif sec_code == "verified":
        sec_fmt = "\x1b[1;32m🛡️\x1b[0m "
    else:
        sec_fmt = "   "

    if seeds >= 50:
        seeds_fmt = f"\x1b[1;32m🌱 {seeds:>4}\x1b[0m"
    elif seeds >= 15:
        seeds_fmt = f"\x1b[32m🌱 {seeds:>4}\x1b[0m"
    elif seeds >= 1:
        seeds_fmt = f"\x1b[33m🌱 {seeds:>4}\x1b[0m"
    else:
        seeds_fmt = f"\x1b[31m🌱 {seeds:>4}\x1b[0m"

    peers_fmt = f"\x1b[33m👥 {peers:>3}\x1b[0m"
    size_fmt = f"\x1b[36m📦 {size_str:>8}\x1b[0m"
    fl_fmt = "\x1b[1;33m⭐FL\x1b[0m " if fl else "    "
    badge_fmt = f"\x1b[1;34m{badge:<12}\x1b[0m"

    if source == "bitmagnet":
        track_fmt = f"\x1b[1;32m[DHT-BitMag ]\x1b[0m"
    else:
        track_fmt = f"\x1b[35m[{tracker:<12}]\x1b[0m"

    # Improvement 1: Fixed-width tech tags column so titles remain tabular and aligned
    tags = r.get("_tags", [])
    if tags:
        top_tags = " ".join([f"[{t}]" for t in tags[:2]])
        tags_col = f"\x1b[90m{top_tags:<20}\x1b[0m "
    else:
        tags_col = " " * 21

    display = f"{sec_fmt}{seeds_fmt}  {peers_fmt}  {size_fmt}  {fl_fmt}{badge_fmt}  {track_fmt}  {tags_col}\x1b[1m{title}\x1b[0m"
    return f"{idx}\t{display}"

def run_query(query_str, config, args, api_key, indexers, quiet=False):
    """Execute concurrent hybrid search across Jackett and BitMagnet."""
    exclude_terms = list(config.get("default_exclude", []))
    if getattr(args, "exclude", None):
        exclude_terms.extend([t.strip().lower() for t in args.exclude.split(",") if t.strip()])

    min_bytes = parse_size(args.min_size) if getattr(args, "min_size", None) else None
    max_bytes = parse_size(args.max_size) if getattr(args, "max_size", None) else None
    min_seeds = args.min_seeds if getattr(args, "min_seeds", None) is not None else config.get("default_min_seeds", 0)

    source_mode = getattr(args, "source", None) or config.get("default_source", "all")
    enable_bitmag = bool(config.get("enable_bitmagnet", False)) and source_mode in ("all", "bitmagnet")
    enable_jackett = source_mode in ("all", "jackett") and bool(indexers)

    sources_desc = []
    if enable_jackett:
        sources_desc.append(f"{len(indexers)} indexers de Jackett")
    if enable_bitmag:
        sources_desc.append("BitMagnet DHT local")

    if not quiet:
        print(f"\x1b[90mBuscando en {' y '.join(sources_desc)} en paralelo...\x1b[0m", end="\r", flush=True)

    results_by_key = {}
    t0 = time.time()
    max_workers = config.get("max_workers", 16)
    timeout = config.get("request_timeout", 5.0)

    with ThreadPoolExecutor(max_workers=max_workers) as executor:
        futures = {}
        if enable_jackett:
            for idx in indexers:
                f = executor.submit(search_indexer, idx, query_str, api_key, config["jackett_url"], timeout)
                futures[f] = f"jackett:{idx}"

        if enable_bitmag:
            bm_url = config.get("bitmagnet_url", "http://127.0.0.1:3333")
            f_bm = executor.submit(search_bitmagnet, query_str, bm_url, 80, timeout)
            futures[f_bm] = "bitmagnet"

        for future in as_completed(futures):
            res_list = future.result()
            for r in res_list:
                link = r.get("MagnetUri") or r.get("Link")
                if not link:
                    continue

                seeds = int(r.get("Seeders") or 0)
                if seeds < min_seeds:
                    continue

                r_size = int(r.get("Size") or 0)
                if min_bytes is not None and r_size < min_bytes:
                    continue
                if max_bytes is not None and r_size > max_bytes:
                    continue

                title = r.get("Title", "")
                lower_title = title.lower()

                if any(ex in lower_title for ex in exclude_terms):
                    continue

                badge, cat_key = get_category_badge(r.get("CategoryDesc"), r.get("Category"), title)
                if getattr(args, "category", None) and cat_key != args.category:
                    continue

                tags = extract_tags(title)
                r["_badge"] = badge
                r["_cat_key"] = cat_key
                r["_tags"] = tags

                infohash = (r.get("InfoHash") or "").lower()
                dedup_key = infohash if infohash else link

                if dedup_key in results_by_key:
                    existing = results_by_key[dedup_key]
                    if r.get("_files_list") and not existing.get("_files_list"):
                        existing["_files_list"] = r["_files_list"]
                        existing["Files"] = r.get("Files", existing.get("Files"))
                    if int(r.get("Seeders") or 0) > int(existing.get("Seeders") or 0):
                        r["_files_list"] = r.get("_files_list") or existing.get("_files_list")
                        results_by_key[dedup_key] = r
                else:
                    results_by_key[dedup_key] = r

    elapsed = time.time() - t0
    results = list(results_by_key.values())

    if not results:
        if not quiet:
            print(f"\x1b[1;33mNo se encontraron torrents para '{query_str}' ({elapsed:.2f}s).\x1b[0m")
        return []

    sort_mode = getattr(args, "sort", None) or config.get("default_sort", "seeds")
    reverse_sort = not getattr(args, "reverse", False)
    if sort_mode == "seeds":
        results.sort(key=lambda x: int(x.get("Seeders") or 0), reverse=reverse_sort)
    elif sort_mode == "peers":
        results.sort(key=lambda x: int(x.get("Peers") or 0), reverse=reverse_sort)
    elif sort_mode == "size":
        results.sort(key=lambda x: int(x.get("Size") or 0), reverse=reverse_sort)
    elif sort_mode == "date":
        results.sort(key=lambda x: str(x.get("PublishDate") or ""), reverse=reverse_sort)

    if not quiet:
        print(f"\x1b[1;32mEncontrados {len(results)} torrents en {elapsed:.2f}s.\x1b[0m Abriendo TUI...")
    return results

def run_fzf_tui(results, config, args, qb_client):
    """Launch fzf interactive browser and handle selection actions."""
    if not results:
        return

    if not shutil.which("fzf"):
        print("\x1b[1;31mError: 'fzf' no está instalado o no se encuentra en el PATH.\x1b[0m")
        print("Instálalo con: sudo pacman -S fzf")
        sys.exit(1)

    cache_fd, cache_path = tempfile.mkstemp(prefix="qjackett_cache_", suffix=".json")
    TEMP_CACHE_FILES.add(cache_path)
    with os.fdopen(cache_fd, "w", encoding="utf-8") as f:
        json.dump(results, f)

    state_fd, state_path = tempfile.mkstemp(prefix="qjackett_state_", suffix=".json")
    TEMP_CACHE_FILES.add(state_path)
    with os.fdopen(state_fd, "w", encoding="utf-8") as sf:
        json.dump({"filter": "all", "sort": "seeds"}, sf)

    fzf_lines = [format_list_line(i, r) for i, r in enumerate(results)]

    py_exec = sys.executable
    script_path = os.path.abspath(sys.argv[0])

    # Improvement 7: Theme handling
    theme_name = config.get("theme", "default").lower()
    theme_cfg = THEMES.get(theme_name, THEMES["default"])
    fzf_color_flag = theme_cfg.get("fzf_color", "")

    header_text = (
        "ENTER: Descargar | TAB: Multi | CTRL+V: Stream | CTRL+E: Select | "
        "CTRL+R: *Arr | CTRL+U: Subs | F1..F5: Filtros | CTRL+S: Orden | F9: Layout | ?: Ayuda"
    )
    fzf_cmd = [
        "fzf",
        "--ansi",
        "--multi",
        "--expect=ctrl-p,ctrl-v,ctrl-e,ctrl-r,ctrl-u",
        "--delimiter=\t",
        "--with-nth=2..",
        "--prompt=🔍 [Todo | Semillas] > ",
        f"--header={header_text}",
        f"--preview={py_exec} {script_path} __preview__ {{1}} {cache_path}",
        "--preview-window=right:48%:wrap",
        # Improvement 4: Layout switching hotkeys
        "--bind=f9:change-preview-window(down,45%|hidden|right,48%)",
        "--bind=alt-p:change-preview-window(down,45%|hidden|right,48%)",
        "--bind=f10:toggle-preview",
        # Improvement 5: Modal help cheat sheet on ? / F12
        f"--bind=?:execute({py_exec} {script_path} __help__ | less -R)",
        f"--bind=f12:execute({py_exec} {script_path} __help__ | less -R)",
        f"--bind=ctrl-y:execute-silent({py_exec} {script_path} __copy_magnet__ {{1}} {cache_path})",
        f"--bind=ctrl-t:execute-silent({py_exec} {script_path} __copy_title__ {{1}} {cache_path})",
        f"--bind=ctrl-b:execute-silent({py_exec} {script_path} __bookmark__ {{1}} {cache_path})",
        f"--bind=ctrl-f:execute({py_exec} {script_path} __files__ {{1}} {cache_path} | less -R)",
        f"--bind=ctrl-d:execute({py_exec} {script_path} __downloads__ | less -R)",
        f"--bind=ctrl-o:execute-silent({py_exec} {script_path} __open_link__ {{1}} {cache_path})",
        # Improvement 3: Dynamic Category & Prompt Reloads
        f"--bind=f1:change-prompt(🎬 Películas | Semillas > )+reload({py_exec} {script_path} __filter__ movies {cache_path} {state_path})",
        f"--bind=f2:change-prompt(📺 Series | Semillas > )+reload({py_exec} {script_path} __filter__ tv {cache_path} {state_path})",
        f"--bind=f3:change-prompt(🎵 Música | Semillas > )+reload({py_exec} {script_path} __filter__ music {cache_path} {state_path})",
        f"--bind=f4:change-prompt(🎮 Juegos | Semillas > )+reload({py_exec} {script_path} __filter__ games {cache_path} {state_path})",
        f"--bind=f5:change-prompt(🔍 Todo | Semillas > )+reload({py_exec} {script_path} __filter__ all {cache_path} {state_path})",
        f"--bind=alt-1:change-prompt(🎬 Películas | Semillas > )+reload({py_exec} {script_path} __filter__ movies {cache_path} {state_path})",
        f"--bind=alt-2:change-prompt(📺 Series | Semillas > )+reload({py_exec} {script_path} __filter__ tv {cache_path} {state_path})",
        f"--bind=alt-3:change-prompt(🎵 Música | Semillas > )+reload({py_exec} {script_path} __filter__ music {cache_path} {state_path})",
        f"--bind=alt-4:change-prompt(🎮 Juegos | Semillas > )+reload({py_exec} {script_path} __filter__ games {cache_path} {state_path})",
        f"--bind=alt-a:change-prompt(🔍 Todo | Semillas > )+reload({py_exec} {script_path} __filter__ all {cache_path} {state_path})",
        f"--bind=ctrl-s:reload({py_exec} {script_path} __toggle_sort__ {cache_path} {state_path})"
    ]

    if fzf_color_flag:
        fzf_cmd.append(fzf_color_flag)

    p = subprocess.Popen(fzf_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    out, _ = p.communicate(input="\n".join(fzf_lines))

    if not out:
        return

    raw_lines = out.split("\n")
    if not raw_lines:
        return

    key_pressed = raw_lines[0].strip()
    selected_lines = [l for l in raw_lines[1:] if l.strip()]

    if "\t" in key_pressed:
        key_pressed = ""
        selected_lines = [l for l in raw_lines if l.strip()]

    if not selected_lines:
        return

    if key_pressed == "ctrl-e":
        idx_val = selected_lines[0].split("\t")[0]
        handle_select_files(idx_val, cache_path, config)
        return
    elif key_pressed == "ctrl-r":
        idx_val = selected_lines[0].split("\t")[0]
        handle_push_arr(idx_val, cache_path, config)
        return
    elif key_pressed == "ctrl-u":
        idx_val = selected_lines[0].split("\t")[0]
        handle_subtitles(idx_val, cache_path)
        return

    is_stream = (key_pressed == "ctrl-v") or getattr(args, "stream", False)
    is_paused = (key_pressed == "ctrl-p") or getattr(args, "paused", False) or config.get("save_paused", False)

    # Collect selected items
    selected_items = []
    for line in selected_lines:
        try:
            idx = int(line.split("\t")[0])
            if 0 <= idx < len(results):
                selected_items.append(results[idx])
        except Exception:
            continue

    if not selected_items:
        return

    # Improvement 6: Multi-selection counter with accumulated size
    total_bytes = sum(int(item.get("Size") or 0) for item in selected_items)
    size_summary = format_size(total_bytes)
    status_label = " (STREAMING SEQUENTIAL)" if is_stream else (" (PAUSADO)" if is_paused else "")
    print(f"\n\x1b[1;34mInyectando {len(selected_items)} torrent(s) a qBittorrent [Peso total: {size_summary}]{status_label}...\x1b[0m")

    success_count = 0
    failed_count = 0
    added_magnets = []

    for item in selected_items:
        raw_link = item.get("MagnetUri") or item.get("Link")
        if not raw_link:
            continue
        link = boost_magnet_link(raw_link, enabled=config.get("tracker_booster", True))
        title = item.get("Title", "Torrent")
        size_str = format_size(item.get("Size", 0))

        cat_key = item.get("_cat_key")
        category = cat_key if config.get("auto_category", True) and cat_key != "other" else None

        tags = []
        if config.get("auto_tags", True):
            tags.append("qjackett")
            if is_stream:
                tags.append("stream")
            tags.extend(item.get("_tags", []))

        ok = qb_client.add_torrent(
            link,
            category=category,
            tags=tags,
            paused=is_paused,
            sequential=is_stream,
            first_last_piece=is_stream
        )
        if ok:
            success_count += 1
            added_magnets.append(link)
            print(f"  \x1b[1;32m✔\x1b[0m {title[:65]} ({size_str})")
        else:
            failed_count += 1
            print(f"  \x1b[1;31m✘\x1b[0m {title[:65]} (Fallo al conectar)")

    # Clipboard sync
    if added_magnets and config.get("auto_copy_magnet", True):
        copy_to_clipboard("\n".join(added_magnets))

    # Notifications
    if config.get("enable_notifications", True):
        if is_stream:
            send_notification("Streaming Iniciado", f"{selected_items[0].get('Title')}\nDescarga secuencial activa", icon="media-playback-start")
        elif len(selected_items) == 1 and success_count == 1:
            it = selected_items[0]
            action_desc = "Torrent Añadido (Pausado)" if is_paused else "Torrent Añadido"
            send_notification(action_desc, f"{it.get('Title')}\n{format_size(it.get('Size', 0))}", icon="qbittorrent")
        elif success_count > 0:
            action_desc = f"{success_count} Torrents Añadidos{' (Pausados)' if is_paused else ''}"
            send_notification(action_desc, f"Se añadieron {success_count} torrents [{size_summary}] a qBittorrent", icon="qbittorrent")

    if success_count > 0 and failed_count == 0:
        if is_stream:
            print(f"\x1b[1;32m✔ ¡Streaming activo! Descarga secuencial priorizada en qBittorrent.\x1b[0m")
            print(f"\x1b[90mTip: Puedes reproducir inmediatamente con: mpv \"{added_magnets[0]}\"\x1b[0m")
        else:
            print(f"\x1b[1;32m✔ ¡Éxito! Todos los torrents se añadieron correctamente.\x1b[0m")
    elif success_count > 0 and failed_count > 0:
        print(f"\x1b[1;33mSe añadieron {success_count} torrents, pero {failed_count} fallaron.\x1b[0m")
    else:
        print(f"\x1b[1;31mFallo al añadir a qBittorrent. Comprueba que el WebUI esté activo.\x1b[0m")
        if added_magnets:
            print("\x1b[1;33mLos enlaces Magnet han sido copiados a tu portapapeles de todas formas.\x1b[0m")



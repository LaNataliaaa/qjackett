class QBittorrentClient:
    """Manages connection, torrent injection, file priorities and monitoring in qBittorrent."""

    def __init__(self, base_url="http://127.0.0.1:8080", username="", password=""):
        self.base_url = base_url.rstrip("/")
        self.username = username or ""
        self.password = password or ""
        self.cookie_jar = http.cookiejar.CookieJar()
        self.opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(self.cookie_jar))

    def login(self):
        """Authenticate with qBittorrent WebUI."""
        if not self.username:
            return True
        login_url = f"{self.base_url}/api/v2/auth/login"
        post_data = urllib.parse.urlencode({
            "username": self.username,
            "password": self.password
        }).encode("utf-8")
        req = urllib.request.Request(
            login_url,
            data=post_data,
            headers={"User-Agent": "qjackett/1.5", "Referer": self.base_url}
        )
        try:
            with self.opener.open(req, timeout=5) as resp:
                text = resp.read().decode("utf-8", errors="ignore")
                return text.strip() == "Ok." or resp.status == 200
        except Exception:
            return False

    def add_torrent(self, urls, category=None, tags=None, paused=False, auto_tmm=True,
                    sequential=False, first_last_piece=False):
        """Inject torrent magnet link or URL into qBittorrent."""
        add_url = f"{self.base_url}/api/v2/torrents/add"
        if isinstance(urls, list):
            urls_str = "\n".join(urls)
        else:
            urls_str = str(urls)

        payload = {
            "urls": urls_str,
            "paused": "true" if paused else "false",
            "autoTMM": "true" if auto_tmm else "false"
        }
        if sequential:
            payload["sequentialDownload"] = "true"
        if first_last_piece:
            payload["firstLastPiecePrio"] = "true"
        if category:
            payload["category"] = category
        if tags:
            if isinstance(tags, (list, set, tuple)):
                payload["tags"] = ", ".join(tags)
            else:
                payload["tags"] = str(tags)

        post_data = urllib.parse.urlencode(payload).encode("utf-8")
        req = urllib.request.Request(
            add_url,
            data=post_data,
            headers={"User-Agent": "qjackett/1.5", "Referer": self.base_url}
        )

        try:
            with self.opener.open(req, timeout=6) as resp:
                return resp.status == 200
        except urllib.error.HTTPError as e:
            status_code = e.code
            try:
                e.close()
            except Exception:
                pass
            if status_code == 403 and self.username:
                if self.login():
                    try:
                        with self.opener.open(req, timeout=6) as resp2:
                            return resp2.status == 200
                    except Exception:
                        return False
            return False
        except Exception:
            return False

    def get_torrents(self, filter="all"):
        """Retrieve list of torrents currently in qBittorrent."""
        url = f"{self.base_url}/api/v2/torrents/info?filter={filter}"
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "qjackett/1.5", "Referer": self.base_url}
        )
        try:
            with self.opener.open(req, timeout=5) as resp:
                return json.loads(resp.read().decode("utf-8", errors="ignore"))
        except urllib.error.HTTPError as e:
            if e.code == 403 and self.username:
                if self.login():
                    try:
                        with self.opener.open(req, timeout=5) as resp2:
                            return json.loads(resp2.read().decode("utf-8", errors="ignore"))
                    except Exception:
                        return []
            return []
        except Exception:
            return []

    def get_torrent_files(self, info_hash):
        """Retrieve file list for a specific torrent in qBittorrent."""
        url = f"{self.base_url}/api/v2/torrents/files?hash={info_hash}"
        req = urllib.request.Request(url, headers={"User-Agent": "qjackett/1.5", "Referer": self.base_url})
        try:
            with self.opener.open(req, timeout=5) as resp:
                return json.loads(resp.read().decode("utf-8", errors="ignore"))
        except Exception:
            return []

    def set_file_priorities(self, info_hash, file_ids, priority=1):
        """Set download priority for specific file IDs in qBittorrent (0=Do not download, 1=Normal, 7=Max)."""
        url = f"{self.base_url}/api/v2/torrents/filePrio"
        ids_str = "|".join(str(i) for i in file_ids)
        post_data = urllib.parse.urlencode({
            "hash": info_hash,
            "id": ids_str,
            "priority": str(priority)
        }).encode("utf-8")
        req = urllib.request.Request(url, data=post_data, headers={"User-Agent": "qjackett/1.5", "Referer": self.base_url})
        try:
            with self.opener.open(req, timeout=5) as resp:
                return resp.status == 200
        except Exception:
            return False

    def resume_torrent(self, info_hash):
        """Resume a torrent by hash."""
        url = f"{self.base_url}/api/v2/torrents/resume"
        post_data = urllib.parse.urlencode({"hashes": info_hash}).encode("utf-8")
        req = urllib.request.Request(url, data=post_data, headers={"User-Agent": "qjackett/1.5", "Referer": self.base_url})
        try:
            with self.opener.open(req, timeout=5) as resp:
                return resp.status == 200
        except Exception:
            return False

    def get_transfer_info(self):
        """Retrieve global download and upload speed from qBittorrent."""
        url = f"{self.base_url}/api/v2/transfer/info"
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "qjackett/1.5", "Referer": self.base_url}
        )
        try:
            with self.opener.open(req, timeout=4) as resp:
                return json.loads(resp.read().decode("utf-8", errors="ignore"))
        except Exception:
            return {}



def clean_title_for_tmdb(title):
    """Clean scene release name down to canonical movie/series name and year."""
    year_m = re.search(r'\b(19\d\d|20\d\d)\b', title)
    year = year_m.group(1) if year_m else None
    t = re.sub(r'[\(\)\[\]]', ' ', title).replace('.', ' ').replace('_', ' ')
    split_pat = r'\b(2160p|1080p|720p|480p|4k|uhd|remux|bluray|bdrip|web-?dl|webrip|hdtv|x264|x265|hevc|dvdrip|s\d+e\d+|s\d+|season|temporada)\b'
    clean = re.split(split_pat, t, flags=re.I)[0].strip()
    if year:
        clean = re.sub(r'\b' + year + r'\b', ' ', clean).strip()
    clean = re.sub(r'\s+', ' ', clean).strip()
    return clean, year

def get_tmdb_metadata(title, cat_key="movies", api_key=TMDB_API_KEY):
    """Fetch movie or TV series metadata from TMDB API in Spanish."""
    if not api_key:
        return None

    clean_name, year = clean_title_for_tmdb(title)
    if not clean_name:
        return None

    is_tv = (cat_key in ("tv", "anime")) or bool(re.search(r'\b(s\d+|season|temporada)\b', title, re.I))
    endpoint = "tv" if is_tv else "movie"

    params = {
        "api_key": api_key,
        "language": "es-ES",
        "query": clean_name
    }
    if year:
        params["first_air_date_year" if is_tv else "year"] = year

    url = f"https://api.themoviedb.org/3/search/{endpoint}?{urllib.parse.urlencode(params)}"
    req = urllib.request.Request(url, headers={"User-Agent": "qjackett/1.5"})
    try:
        with urllib.request.urlopen(req, timeout=2.5) as resp:
            data = json.loads(resp.read().decode("utf-8", errors="ignore"))
            results = data.get("results") or []
            if results:
                top = results[0]
                poster_path = top.get("poster_path")
                poster_url = f"https://image.tmdb.org/t/p/w500{poster_path}" if poster_path else None
                return {
                    "id": top.get("id"),
                    "title": top.get("title") or top.get("name") or clean_name,
                    "original_title": top.get("original_title") or top.get("original_name") or "",
                    "overview": top.get("overview") or "",
                    "vote_average": top.get("vote_average", 0),
                    "release_date": top.get("release_date") or top.get("first_air_date") or year or "N/A",
                    "poster_url": poster_url,
                    "is_tv": is_tv
                }
    except Exception:
        pass
    return None

def render_poster_terminal(poster_url, title_id):
    """Download poster to cache and render high-resolution graphic thumbnail in terminal."""
    if not poster_url or not shutil.which("chafa"):
        return False
    try:
        os.makedirs(DEFAULT_POSTERS_DIR, exist_ok=True)
        filename = f"{title_id}.jpg"
        cached_path = os.path.join(DEFAULT_POSTERS_DIR, filename)

        if not os.path.exists(cached_path):
            req = urllib.request.Request(poster_url, headers={"User-Agent": "qjackett/1.5"})
            with urllib.request.urlopen(req, timeout=3) as resp, open(cached_path, "wb") as f:
                f.write(resp.read())

        cols_env = os.environ.get("FZF_PREVIEW_COLUMNS")
        lines_env = os.environ.get("FZF_PREVIEW_LINES")

        preview_cols = int(cols_env) if cols_env and cols_env.isdigit() else 50
        preview_lines = int(lines_env) if lines_env and lines_env.isdigit() else 35

        w = max(24, min(36, preview_cols - 4))
        h = max(15, min(22, int(w * 0.65), preview_lines // 2))

        is_kitty = bool(os.environ.get("KITTY_PID") or os.environ.get("TERM") == "xterm-kitty" or os.environ.get("TERM_PROGRAM") == "kitty")
        is_foot = bool(os.environ.get("FOOT_SERVER_SOCKET") or "foot" in os.environ.get("TERM", ""))

        if is_kitty:
            cmd = ["chafa", "-f", "kitty", "-s", f"{w}x{h}", cached_path]
        elif is_foot:
            cmd = ["chafa", "-f", "sixels", "-s", f"{w}x{h}", cached_path]
        else:
            cmd = ["chafa", "--symbols=vhalf,hhalf,quad,block,braille", "-s", f"{w}x{h}", cached_path]

        p = subprocess.run(cmd, capture_output=True, check=False)
        if p.returncode == 0 and p.stdout:
            extra_lines = ("\n" * (h + 1)) if (is_kitty or is_foot) else "\n"
            if hasattr(sys.stdout, "buffer"):
                sys.stdout.buffer.write(p.stdout)
                sys.stdout.buffer.write(extra_lines.encode("utf-8"))
                sys.stdout.flush()
            else:
                sys.stdout.write(p.stdout.decode("utf-8", errors="ignore") + extra_lines)
                sys.stdout.flush()
            return True
    except Exception:
        pass
    return False



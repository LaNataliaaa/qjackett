def load_config(custom_path=None):
    """Load configuration from file, falling back to defaults and env vars."""
    config = dict(DEFAULT_CONFIG)
    config_file = custom_path or os.environ.get("QJACKETT_CONFIG") or DEFAULT_CONFIG_PATH

    if os.path.isfile(config_file):
        try:
            with open(config_file, "r", encoding="utf-8") as f:
                user_cfg = json.load(f)
                config.update(user_cfg)
        except Exception as e:
            print(f"\x1b[33mAdvertencia: No se pudo leer {config_file}: {e}\x1b[0m", file=sys.stderr)

    # Environment variables overrides
    if os.environ.get("JACKETT_URL"):
        config["jackett_url"] = os.environ["JACKETT_URL"]
    if os.environ.get("JACKETT_API_KEY"):
        config["jackett_api_key"] = os.environ["JACKETT_API_KEY"]
    if os.environ.get("QBITTORRENT_URL"):

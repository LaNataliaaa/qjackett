SUSPICIOUS_EXTENSIONS = {".exe", ".scr", ".bat", ".cmd", ".vbs", ".js", ".wsf", ".msi", ".pif", ".hta", ".cpl"}

def check_security_status(title, size_bytes, cat_key, files_list=None, seeders=0, leechers=0, tracker=""):
    """
    Heuristic security analysis for detecting fake torrents, malware, or suspicious swarms.
    Returns: (status_code, badge, warning_message)
    status_code: 'clean', 'verified', 'warning', 'danger'
    """
    title_lower = title.lower()

    if cat_key in ("movies", "tv", "anime", "music", "books"):
        for ext in SUSPICIOUS_EXTENSIONS:
            if title_lower.endswith(ext) or f"{ext}." in title_lower or f" {ext}" in title_lower:
                return "danger", "☣️ MALWARE/EJECUTABLE", f"¡ALERTA! El torrent tiene extensión ejecutable '{ext}' pero está catalogado como {cat_key}."
        if files_list:
            for fl in files_list:
                p = fl.get("path", "").lower()
                if any(p.endswith(e) for e in SUSPICIOUS_EXTENSIONS):
                    return "danger", "☣️ EJECUTABLE SOSPECHOSO", f"¡ALERTA! Contiene un archivo ejecutable interno: {p}"

    if cat_key in ("movies", "tv", "anime"):
        if any(tag in title_lower for tag in ("2160p", "4k", "remux", "bluray", "1080p")):
            if 0 < size_bytes < 35 * 1024 * 1024:
                return "danger", "⚠️ FALSO / TAMAÑO ANÓMALO", "¡ALERTA! El tamaño es menor a 35 MB para un release que afirma ser 1080p/4K."

    if seeders == 0 and leechers > 300:
        return "warning", "⚠️ ENJAMBRE FALSO", "Atención: Enjambre inflado artificialmente con 0 semillas y muchos clientes falsos."

    trusted_trackers = ("bitmagnet", "rarbg", "yts", "1337x", "eztv", "torrentgalaxy", "rutracker", "nyaa")
    tracker_lower = (tracker or "").lower()
    if any(t in tracker_lower for t in trusted_trackers):
        return "verified", "🛡️ Verificado", "Fuente o tracker con reputación conocida y verificada."

    return "clean", "", ""

def extract_tags(title):
    """Extract release tags from torrent title using regex patterns."""
    if not title:
        return []
    tags = []
    t = title

    # Resolution
    if re.search(r'\b(2160p|4k|uhd)\b', t, re.I):
        tags.append("2160p/4K")
    elif re.search(r'\b1080p\b', t, re.I):
        tags.append("1080p")
    elif re.search(r'\b720p\b', t, re.I):
        tags.append("720p")
    elif re.search(r'\b480p\b', t, re.I):
        tags.append("480p")

    # Source
    if re.search(r'\b(remux)\b', t, re.I):
        tags.append("Remux")
    elif re.search(r'\b(bluray|bdrip|brrip)\b', t, re.I):
        tags.append("BluRay")
    elif re.search(r'\b(web-?dl|webrip)\b', t, re.I):
        tags.append("WEB-DL")
    elif re.search(r'\b(hdtv)\b', t, re.I):
        tags.append("HDTV")
    elif re.search(r'\b(dvdrip|dvd)\b', t, re.I):
        tags.append("DVDRip")

    # Codecs
    if re.search(r'\b(x265|hevc|h\.?265)\b', t, re.I):
        tags.append("x265")
    elif re.search(r'\b(x264|avc|h\.?264)\b', t, re.I):
        tags.append("x264")
    elif re.search(r'\b(av1)\b', t, re.I):
        tags.append("AV1")

    # HDR / Color
    if re.search(r'\b(dolby[ ._-]?vision|dv)\b', t, re.I):
        tags.append("DV")
    if re.search(r'(hdr10\+|hdr10plus)', t, re.I):
        tags.append("HDR10+")
    elif re.search(r'\b(hdr10|hdr)\b', t, re.I):
        tags.append("HDR")

    # Audio
    if re.search(r'\b(atmos)\b', t, re.I):
        tags.append("Atmos")
    if re.search(r'\b(truehd)\b', t, re.I):
        tags.append("TrueHD")
    elif re.search(r'\b(dts-?hd(\s*ma)?)\b', t, re.I):
        tags.append("DTS-HD")
    elif re.search(r'\b(dts)\b', t, re.I):
        tags.append("DTS")
    elif re.search(r'\b(ddp|dd\+|eac3)\b', t, re.I):
        tags.append("DDP")
    elif re.search(r'\b(flac)\b', t, re.I):
        tags.append("FLAC")

    # Language
    if re.search(r'\b(castellano|spanish|espa[ñn]ol)\b', t, re.I):
        tags.append("Castellano")
    if re.search(r'\b(latino)\b', t, re.I):
        tags.append("Latino")
    if re.search(r'\b(dual|multi)\b', t, re.I):
        tags.append("Dual")
    if re.search(r'\b(vose|sub(s|titulada)?)\b', t, re.I):
        tags.append("VOSE")

    return tags

def get_category_badge(cat_desc, cat_ids, title=""):
    """Return an icon badge and canonical category key based on Torznab category."""
    desc = (cat_desc or "").lower()
    t = (title or "").lower()
    ids = cat_ids if isinstance(cat_ids, list) else ([cat_ids] if cat_ids is not None else [])

    if "anime" in desc or any(c in (5070,) for c in ids) or "[anime" in t or "horriblesubs" in t or "subsplease" in t:
        return "🎌 Anime", "anime"
    if "movie" in desc or "pelicula" in desc or "peli" in desc or any(2000 <= c < 3000 for c in ids):
        return "🎬 Película", "movies"
    if "tv" in desc or "serie" in desc or any(5000 <= c < 6000 for c in ids):
        return "📺 Serie", "tv"
    if "game" in desc or "juego" in desc or any(1000 <= c < 2000 or c == 4050 for c in ids):
        return "🎮 Juego", "games"
    if "audio" in desc or "music" in desc or "lossless" in desc or any(3000 <= c < 4000 for c in ids):

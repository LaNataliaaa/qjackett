def extract_tags(title):
    """Extract quality, codec, source, HDR, and audio tags from title."""
    t = (title or "").lower()
    tags = []

    # Resolution
    if re.search(r'\b(2160p|4k|uhd)\b', t):
        tags.append('2160p/4K')
    elif re.search(r'\b(1440p|2k)\b', t):
        tags.append('1440p')
    elif re.search(r'\b(1080p|fhd)\b', t):
        tags.append('1080p')
    elif re.search(r'\b(720p|hd)\b', t):
        tags.append('720p')
    elif re.search(r'\b(576p|480p|sd)\b', t):
        tags.append('480p')

    # Source
    if re.search(r'\b(remux)\b', t):
        tags.append('Remux')
    elif re.search(r'\b(bluray|bdrip|brrip)\b', t):
        tags.append('BluRay')
    elif re.search(r'\b(web-?dl|webrip)\b', t):
        tags.append('WEB-DL')
    elif re.search(r'\b(hdtv|pdtv)\b', t):
        tags.append('HDTV')
    elif re.search(r'\b(dvdrip|dvd-?r)\b', t):
        tags.append('DVDRip')
    elif re.search(r'\b(cam|camrip|hdcam|ts|telesync|hdts)\b', t):
        tags.append('CAM/TS')

    # Video Codec
    if re.search(r'\b(av1)\b', t):
        tags.append('AV1')
    elif re.search(r'\b(hevc|h\.?265|x265)\b', t):
        tags.append('x265')
    elif re.search(r'\b(avc|h\.?264|x264)\b', t):
        tags.append('x264')
    elif re.search(r'\b(xvid)\b', t):
        tags.append('XviD')

    # Dynamic Range
    if re.search(r'(?:\bdolby\s*vision\b|\bdovi\b|\bdv\b)', t):
        tags.append('DV')
    if re.search(r'(?:\bhdr10\+(?!\w)|\bhdr10plus\b)', t):
        tags.append('HDR10+')
    elif re.search(r'\b(hdr10|hdr)\b', t):
        tags.append('HDR')

    # Audio
    if re.search(r'\b(atmos)\b', t):
        tags.append('Atmos')
    if re.search(r'\b(truehd)\b', t):
        tags.append('TrueHD')
    elif re.search(r'\b(dts-?hd(\s*ma)?|dts:x)\b', t):
        tags.append('DTS-HD')
    elif re.search(r'\b(dts)\b', t):
        tags.append('DTS')
    if re.search(r'\b(flac)\b', t):
        tags.append('FLAC')
    if re.search(r'\b(eac3|ddp5?\.?1?|dd\+)\b', t):
        tags.append('DDP')
    elif re.search(r'\b(ac3|dd5?\.?1?)\b', t):
        tags.append('AC3')

    # Languages
    if re.search(r'\b(dual)\b', t):
        tags.append('Dual')
    elif re.search(r'\b(multi)\b', t):
        tags.append('Multi')
    if re.search(r'\b(castellano|spanish|español)\b', t):
        tags.append('Castellano')
    elif re.search(r'\b(latino)\b', t):
        tags.append('Latino')
    if re.search(r'\b(vose|subtitulado|subs?)\b', t):
        tags.append('VOSE')

    return tags

def get_category_badge(cat_desc, cat_ids, title=""):
    """Classify release into category badge and normalized category key."""
    desc = (cat_desc or "").lower()
    t = (title or "").lower()
    ids = cat_ids or []

    # Anime (Torznab 5070 or keywords)
    if any(c in (5070,) for c in ids) or "anime" in desc or "anime" in t:
        return "🎌 Anime", "anime"
    # Movies (Torznab 2000-2999)
    if "movie" in desc or "pelicula" in desc or any(2000 <= c < 3000 for c in ids):
        return "🎬 Película", "movies"
    # TV Shows / Series (Torznab 5000-5999)
    if "tv" in desc or "serie" in desc or any(5000 <= c < 6000 for c in ids):
        return "📺 Serie", "tv"
    # Games (Torznab 1000-1999, 4050)
    if "game" in desc or "juego" in desc or any(1000 <= c < 2000 or c == 4050 for c in ids):
        return "🎮 Juego", "games"
    # Music / Audio (Torznab 3000-3999)
    if "audio" in desc or "music" in desc or "lossless" in desc or any(3000 <= c < 4000 for c in ids):
        return "🎵 Música", "music"
    # Books / Ebooks (Torznab 7000-7999)
    if "book" in desc or "libro" in desc or "comic" in desc or any(7000 <= c < 8000 for c in ids):
        return "📚 Libro", "books"
    # Adult / XXX (Torznab 6000-6999)
    if "xxx" in desc or "adult" in desc or any(6000 <= c < 7000 for c in ids):
        return "🔞 Adulto", "xxx"
    # Software / PC (Torznab 4000-4999)
    if "pc" in desc or "app" in desc or "soft" in desc or any(4000 <= c < 5000 for c in ids):
        return "💻 Software", "apps"

    return "📦 General", "other"

def render_health_bar(seeds, peers, width=20):
    """Render a visual ASCII/block health bar for swarm activity."""
    total = seeds + peers
    if total == 0:
        return "\x1b[31m[░░░░░░░░░░░░░░░░░░░░] 0% (Sin actividad)\x1b[0m"
    ratio = seeds / total
    filled = int(round(ratio * width))
    bar = "█" * filled + "░" * (width - filled)
    pct = int(ratio * 100)
    if seeds >= 50:
        color = "\x1b[1;32m"
        desc = "Excelente"
    elif seeds >= 15:
        color = "\x1b[32m"
        desc = "Buena"
    elif seeds >= 1:
        color = "\x1b[33m"
        desc = "Aceptable"
    else:
        color = "\x1b[31m"
        desc = "Crítica"
    return f"{color}[{bar}] {pct}% ({desc})\x1b[0m"



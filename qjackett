def load_bookmarks(path=DEFAULT_BOOKMARKS_PATH):
    """Load saved torrent bookmarks from JSON."""
    if not os.path.exists(path):
        return []
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return []

def save_bookmark(item, path=DEFAULT_BOOKMARKS_PATH):
    """Save a torrent to the bookmarks list if not already present."""
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    bookmarks = load_bookmarks(path)
    info_hash = (item.get("InfoHash") or "").lower()
    link = item.get("MagnetUri") or item.get("Link") or ""

    for b in bookmarks:
        b_hash = (b.get("InfoHash") or "").lower()
        b_link = b.get("MagnetUri") or b.get("Link") or ""
        if (info_hash and b_hash == info_hash) or (link and b_link == link):
            return False, "Ya estaba en marcadores"

    item_copy = dict(item)
    item_copy["_bookmarked_at"] = time.strftime("%Y-%m-%d %H:%M:%S")
    bookmarks.append(item_copy)
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(bookmarks, f, indent=2, ensure_ascii=False)
        return True, "Guardado en marcadores"
    except Exception as e:
        return False, str(e)


